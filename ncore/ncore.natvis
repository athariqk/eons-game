<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="nc::RID">
		<DisplayString>RID({value})</DisplayString>
		<Expand>
			<Item Name="value">value</Item>
		</Expand>
	</Type>

	<Type Name="nc::ResourceFormatID">
		<DisplayString>ResourceFormatID({id})</DisplayString>
		<Expand>
			<Item Name="id">id</Item>
			<Item Name="id (hex)">id,x</Item>
		</Expand>
	</Type>

	<Type Name="nc::Ref&lt;*&gt;">
		<DisplayString Condition="obj == 0">null</DisplayString>
		<DisplayString Condition="obj != 0">{*obj}</DisplayString>
		<Expand>
			<Item Name="ptr">obj</Item>
			<ExpandedItem Condition="obj != 0">*obj</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="nc::Vec2">
		<DisplayString>({x}, {y})</DisplayString>
		<Expand>
			<Item Name="x">x</Item>
			<Item Name="y">y</Item>
		</Expand>
	</Type>

	<Type Name="nc::Vec4">
		<DisplayString>({x}, {y}, {z}, {w})</DisplayString>
		<Expand>
			<Item Name="x">x</Item>
			<Item Name="y">y</Item>
			<Item Name="z">z</Item>
			<Item Name="w">w</Item>
		</Expand>
	</Type>

	<Type Name="nc::Color">
		<DisplayString>(r={r}, g={g}, b={b}, a={a})</DisplayString>
		<Expand>
			<Item Name="r">r</Item>
			<Item Name="g">g</Item>
			<Item Name="b">b</Item>
			<Item Name="a">a</Item>
		</Expand>
	</Type>

	<Type Name="nc::Vertex2D">
		<DisplayString>pos=({x}, {y}) uv=({u}, {v}) color={color}</DisplayString>
		<Expand>
			<Synthetic Name="pos">
				<DisplayString>({x}, {y})</DisplayString>
			</Synthetic>
			<Synthetic Name="uv">
				<DisplayString>({u}, {v})</DisplayString>
			</Synthetic>
			<Item Name="color">color</Item>
		</Expand>
	</Type>

	<Type Name="nc::Vertex3D">
		<DisplayString>pos=({px}, {py}, {pz}) uv=({u}, {v}) color={color}</DisplayString>
		<Expand>
			<Synthetic Name="pos">
				<DisplayString>({px}, {py}, {pz})</DisplayString>
			</Synthetic>
			<Synthetic Name="normal">
				<DisplayString>({nx}, {ny}, {nz})</DisplayString>
			</Synthetic>
			<Synthetic Name="tangent">
				<DisplayString>({tx}, {ty}, {tz})</DisplayString>
			</Synthetic>
			<Synthetic Name="uv">
				<DisplayString>({u}, {v})</DisplayString>
			</Synthetic>
			<Synthetic Name="uv2">
				<DisplayString>({u2}, {v2})</DisplayString>
			</Synthetic>
			<Item Name="color">color</Item>
		</Expand>
	</Type>

	<Type Name="nc::SkinnedVertex3D">
		<DisplayString>pos=({px}, {py}, {pz}) weights=[{weights[0]}, {weights[1]}, {weights[2]}, {weights[3]}]</DisplayString>
		<Expand>
			<Synthetic Name="pos">
				<DisplayString>({px}, {py}, {pz})</DisplayString>
			</Synthetic>
			<Synthetic Name="normal">
				<DisplayString>({nx}, {ny}, {nz})</DisplayString>
			</Synthetic>
			<Synthetic Name="tangent">
				<DisplayString>({tx}, {ty}, {tz})</DisplayString>
			</Synthetic>
			<Synthetic Name="uv">
				<DisplayString>({u}, {v})</DisplayString>
			</Synthetic>
			<Synthetic Name="uv2">
				<DisplayString>({u2}, {v2})</DisplayString>
			</Synthetic>
			<Item Name="color">color</Item>
			<ArrayItems>
				<Size>4</Size>
				<ValuePointer>weights</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="nc::DynArray&lt;*&gt;">
		<DisplayString>{{ size={((std::vector&lt;$T1&gt;*)this)-&gt;size()} bytes={((std::vector&lt;$T1&gt;*)this)-&gt;size() * sizeof($T1)} }}</DisplayString>
		<Expand>
			<Item Name="size">((std::vector&lt;$T1&gt;*)this)-&gt;size()</Item>
			<Item Name="capacity">((std::vector&lt;$T1&gt;*)this)-&gt;capacity()</Item>
			<Item Name="bytes">((std::vector&lt;$T1&gt;*)this)-&gt;size() * sizeof($T1)</Item>
			<ExpandedItem>*(std::vector&lt;$T1&gt;*)this</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="nc::HashMap&lt;*,*&gt;">
		<DisplayString>{{ size={((std::unordered_map&lt;$T1,$T2&gt;*)this)-&gt;size()} bytes(approx)={((std::unordered_map&lt;$T1,$T2&gt;*)this)-&gt;size() * sizeof(std::pair&lt;const $T1,$T2&gt;)} }}</DisplayString>
		<Expand>
			<Item Name="size">((std::unordered_map&lt;$T1,$T2&gt;*)this)-&gt;size()</Item>
			<Item Name="bytes (approx, excludes bucket overhead)">((std::unordered_map&lt;$T1,$T2&gt;*)this)-&gt;size() * sizeof(std::pair&lt;const $T1,$T2&gt;)</Item>
			<ExpandedItem>*(std::unordered_map&lt;$T1,$T2&gt;*)this</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="nc::Array&lt;*,*&gt;">
		<DisplayString>{{ size={$T2} bytes={$T2 * sizeof($T1)} }}</DisplayString>
		<Expand>
			<Item Name="size">$T2</Item>
			<Item Name="bytes">$T2 * sizeof($T1)</Item>
			<ExpandedItem>*(std::array&lt;$T1,$T2&gt;*)this</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="nc::RenderStorage::PSOFlags">
		<DisplayString>
			Cull={((__int64)$e) &amp; 0x3}
			Depth=[test={((((__int64)$e) &amp; 0x4) != 0) ? "ON" : "OFF"} write={((((__int64)$e) &amp; 0x8) != 0) ? "ON" : "OFF"}]
			Blend={(((__int64)$e) &gt;&gt; 4) &amp; 0xF}
			Scissor={((((__int64)$e) &amp; 0x8000000) != 0) ? "ON" : "OFF"}
			(raw=0x{(__int64)$e,x})
		</DisplayString>
		<Expand>
			<Item Name="cull">((__int64)$e) &amp; 0x3</Item>
			<Item Name="depth_test">((((__int64)$e) &amp; 0x4) != 0) ? "ON" : "OFF"</Item>
			<Item Name="depth_write">((((__int64)$e) &amp; 0x8) != 0) ? "ON" : "OFF"</Item>
			<Item Name="blend">(((__int64)$e) &gt;&gt; 4) &amp; 0xF</Item>
			<Item Name="scissor">((((__int64)$e) &amp; 0x8000000) != 0) ? "ON" : "OFF"</Item>
			<Item Name="raw">(__int64)$e</Item>
		</Expand>
	</Type>

	<Type Name="nc::RenderStorage::PSOKey">
		<DisplayString>{debug_name} (vs={vs}, ps={ps})</DisplayString>
		<Expand>
			<Item Name="debug_name">debug_name</Item>
			<Item Name="flags">flags</Item>
			<Item Name="vs">vs</Item>
			<Item Name="ps">ps</Item>
			<Item Name="vertex_layout">vertex_layout</Item>
			<Item Name="resource_signatures">resource_signatures</Item>
		</Expand>
	</Type>

	<Type Name="nc::Material">
		<DisplayString>Material (pso={pso})</DisplayString>
		<Expand>
			<Item Name="pso">pso</Item>
			<Item Name="resource_signatures">resource_signatures</Item>
			<Item Name="srbs">srbs</Item>
			<Item Name="sampler">sampler</Item>
			<Item Name="constant_buffer">constant_buffer</Item>
			<Item Name="texture_slots">texture_slots</Item>
		</Expand>
	</Type>

	<Type Name="nc::TextureSlot">
		<DisplayString>{name} (srb={srb_index})</DisplayString>
		<Expand>
			<Item Name="name">name</Item>
			<Item Name="srb_index">srb_index</Item>
		</Expand>
	</Type>

	<Type Name="nc::Material::TextureSlot">
		<DisplayString>{name} (srb={srb_index})</DisplayString>
		<Expand>
			<Item Name="name">name</Item>
			<Item Name="srb_index">srb_index</Item>
		</Expand>
	</Type>

	<Type Name="nc::VertexLayoutElement">
		<DisplayString>loc={location} slot={buffer_slot} type={type} offset={relative_offset}</DisplayString>
		<Expand>
			<Item Name="location">location</Item>
			<Item Name="type">type</Item>
			<Item Name="buffer_slot">buffer_slot</Item>
			<Item Name="stride">stride</Item>
			<Item Name="relative_offset">relative_offset</Item>
			<Item Name="normalized">normalized</Item>
			<Item Name="hlsl_semantic">hlsl_semantic</Item>
		</Expand>
	</Type>

	<Type Name="nc::RenderContext">
		<DisplayString>RenderContext (canvas: {canvas_verts}/{canvas_vb_size} verts, {canvas_indices}/{canvas_ib_size} indices)</DisplayString>
		<Expand>
			<Item Name="rhi">rhi</Item>
			<Item Name="canvas_vb">canvas_vb</Item>
			<Item Name="canvas_ib">canvas_ib</Item>
			<Item Name="canvas_verts (used)">canvas_verts</Item>
			<Item Name="canvas_vb_size (capacity)">canvas_vb_size</Item>
			<Item Name="canvas_vb_bytes (capacity)">canvas_vb_size * sizeof(nc::Vertex2D)</Item>
			<Item Name="canvas_indices (used)">canvas_indices</Item>
			<Item Name="canvas_ib_size (capacity)">canvas_ib_size</Item>
			<Item Name="canvas_material">canvas_material</Item>
			<Item Name="canvas_clip">canvas_clip</Item>
		</Expand>
	</Type>

	<Type Name="nc::ShaderParamInfo">
		<DisplayString>{name} (type={resource_type}, binding={binding_idx}@space{binding_space})</DisplayString>
		<Expand>
			<Item Name="name">name</Item>
			<Item Name="semantic_name">semantic_name</Item>
			<Item Name="resource_type">resource_type</Item>
			<Item Name="value_type">value_type</Item>
			<Item Name="binding_idx">binding_idx</Item>
			<Item Name="binding_space">binding_space</Item>
			<Item Name="location">location</Item>
			<Item Name="fields">fields</Item>
			<Item Name="stage_mask">stage_mask</Item>
		</Expand>
	</Type>

	<Type Name="nc::ShaderParamField">
		<DisplayString>{name} (type={type}, offset={offset})</DisplayString>
		<Expand>
			<Item Name="name">name</Item>
			<Item Name="offset">offset</Item>
			<Item Name="size">size</Item>
			<Item Name="stride">stride</Item>
			<Item Name="type">type</Item>
		</Expand>
	</Type>

	<Type Name="nc::Geometry&lt;*&gt;">
		<DisplayString>{{ verts={((std::vector&lt;$T1&gt;*)&amp;vertices)-&gt;size()} indices={((std::vector&lt;uint16_t&gt;*)&amp;indices)-&gt;size()} topology={topology} }}</DisplayString>
		<Expand>
			<Item Name="topology">topology</Item>
			<Item Name="vertex_count">((std::vector&lt;$T1&gt;*)&amp;vertices)-&gt;size()</Item>
			<Item Name="index_count">((std::vector&lt;uint16_t&gt;*)&amp;indices)-&gt;size()</Item>
			<Item Name="vertex_bytes">((std::vector&lt;$T1&gt;*)&amp;vertices)-&gt;size() * sizeof($T1)</Item>
			<Item Name="index_bytes">((std::vector&lt;uint16_t&gt;*)&amp;indices)-&gt;size() * sizeof(unsigned int)</Item>
			<Item Name="total_bytes">(((std::vector&lt;$T1&gt;*)&amp;vertices)-&gt;size() * sizeof($T1)) + (((std::vector&lt;uint16_t&gt;*)&amp;indices)-&gt;size() * sizeof(unsigned int))</Item>
			<Item Name="vertices">vertices</Item>
			<Item Name="indices">indices</Item>
		</Expand>
	</Type>

	<Type Name="nc::ResourceManager">
		<DisplayString>ResourceManager (importers={num_importers}, cached_paths={((std::unordered_map&lt;std::string,nc::RID&gt;*)&amp;path_map)-&gt;size()})</DisplayString>
		<Expand>
			<Item Name="num_importers">num_importers</Item>
			<Item Name="path_map">path_map</Item>
		</Expand>
	</Type>

	<Type Name="nc::MaterialTemplate">
		<DisplayString>{debug_name} (params={((std::vector&lt;nc::ShaderParamInfo&gt;*)&amp;params)-&gt;size()}, textures={((std::vector&lt;nc::TextureSlot&gt;*)&amp;textures)-&gt;size()})</DisplayString>
		<Expand>
			<Item Name="debug_name">debug_name</Item>
			<Item Name="vs">vs</Item>
			<Item Name="ps">ps</Item>
			<Item Name="cull_mode">cull_mode</Item>
			<Item Name="depth_test">depth_test</Item>
			<Item Name="depth_write">depth_write</Item>
			<Item Name="blend">blend</Item>
			<Item Name="multisample_state">multisample_state</Item>
			<Item Name="params">params</Item>
			<Item Name="textures">textures</Item>
		</Expand>
	</Type>

	<Type Name="nc::MultisampleStateDesc">
		<DisplayString>MSAA count={count} quality={quality}</DisplayString>
		<Expand>
			<Item Name="count">count</Item>
			<Item Name="quality">quality</Item>
		</Expand>
	</Type>

	<Type Name="nc::ResourceSignatureDesc">
		<DisplayString>{name} (set={set}, resources={((std::vector&lt;nc::PipelineResourceDesc&gt;*)&amp;resources)-&gt;size()})</DisplayString>
		<Expand>
			<Item Name="name">name</Item>
			<Item Name="set">set</Item>
			<Item Name="resources">resources</Item>
		</Expand>
	</Type>

	<Type Name="nc::PipelineResourceDesc">
		<DisplayString>{name} (type={resource_type}, stage={stage}, array_size={array_size})</DisplayString>
		<Expand>
			<Item Name="name">name</Item>
			<Item Name="resource_type">resource_type</Item>
			<Item Name="stage">stage</Item>
			<Item Name="array_size">array_size</Item>
		</Expand>
	</Type>

</AutoVisualizer>
